# ── Build output ──────────────────────────────────────────────────────────────
build/dist/
build/win/
build/installer/
build/npm/
build/npm-bin/
dist-extra/
brew-assets/
dist/
# web/ui/dist is the new UI build embedded by web/ui_embed.go. Only its
# .gitkeep is tracked, so `go build` works on a fresh clone without Node.
!web/ui/dist/
web/ui/dist/*
!web/ui/dist/.gitkeep
*.exe
*.dll
*.so
*.dylib
/kongtrol

# Generated Windows exe-icon resources (make build-tray-native, release.yml,
# .goreleaser.yaml) from assets/logo.ico via akavel/rsrc — not source, do not commit.
cmd/kongtrol-tray/rsrc_windows*.syso

# ── Go ────────────────────────────────────────────────────────────────────────
vendor/
*.test
*.out
coverage.out
coverage.html
cpu.prof
mem.prof

# ── Credentials & secrets ─────────────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
*.ovpn
*.conf
configs/local/
.env
.env.*
secrets/

# kongtrol user config (local overrides — never commit personal VPN config)
kongtrol.yaml
config.yaml
~/.kongtrol/

# ── OS ────────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.Trash-*

# ── AI tooling (local harness config / skills cache) ──────────────────────────
.claude/
.agents/
/agent/
skills-lock.json

# ── Editors & IDEs ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.vim
*.sublime-project
*.sublime-workspace
.history/

# ── Tooling ───────────────────────────────────────────────────────────────────
# goreleaser
.goreleaser-artifacts/

# air (live reload)
tmp/
.air.toml.local

# golangci-lint cache
.golangci-lint-cache/

# Test artifacts
testdata/local/

# ── Logs & runtime ────────────────────────────────────────────────────────────
*.log
audit.log
*.pid

# lychee link-check cache (lychee.toml)
.lycheecache

# Wrangler local cache/state (account id, dev state) — machine-local
.wrangler/
