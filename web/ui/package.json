{
  "name": "kongtrol-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Kongtrol dashboard UI (Vite + React + TypeScript), embedded in the Go binary and served at /.",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "tsc -b && oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@tanstack/react-query": "5.105.3",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
