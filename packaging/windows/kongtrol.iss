; Kongtrol per-user Windows installer (Inno Setup 6) — version 1.7.0 · 2026-11-20
;
; Built by .github/workflows/release.yml (job "windows"); decision and sources
; in docs/adr/0025-desktop-release-channels-first-run.md; an existing install
; is detected and the wizard becomes "Actualizar" / "Reinstalar" / "versión
; anterior" (docs/adr/0046-installers-detect-existing-install.md); icon and wizard
; images in docs/adr/0052-app-icon-and-installer-branding.md. Installs for the current
; user only (no admin): kongtrol.exe (CLI + daemon) and kongtrol-tray.exe side by
; side in %LOCALAPPDATA%\Programs\Kongtrol, a Start menu entry, optional
; autostart at sign-in, the user PATH entry (on by default), and optionally the network
; helper (`kongtrol service install`, which shows one UAC prompt itself).
;
; Local build (Windows, Inno Setup 6 installed):
;   iscc /DAppVersion=1.2.3 /DSourceDir=..\..\build\win packaging\windows\kongtrol.iss

#ifndef AppVersion
  #define AppVersion "0.0.0-dev"
#endif
#ifndef SourceDir
  #define SourceDir "..\..\build\win"
#endif
#ifndef OutputDir
  #define OutputDir "..\..\build\installer"
#endif

[Setup]
; AppId identifies the product for upgrades and uninstall: never change it.
AppId={{BA277280-D8B2-4309-8620-BCEECBAA4B41}
AppName=Kongtrol
AppVersion={#AppVersion}
AppVerName=Kongtrol {#AppVersion}
; Author and publisher (ADR-0081): one person, not a company. UTF-8, like the
; Spanish messages below.
AppPublisher=Rubén Luna
AppCopyright=Copyright 2026 Rubén Luna
AppPublisherURL=https://kongtrol.app
AppSupportURL=https://kongtrol.app/guia
DefaultDirName={autopf}\Kongtrol
DefaultGroupName=Kongtrol
DisableProgramGroupPage=yes
; Per-user install: {autopf} becomes %LOCALAPPDATA%\Programs, registry goes to
; HKCU. No UAC prompt for the install itself.
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#OutputDir}
OutputBaseFilename=Kongtrol-Setup-windows-amd64
SetupIconFile=..\..\assets\logo.ico
UninstallDisplayIcon={app}\kongtrol-tray.exe
UninstallDisplayName=Kongtrol
LicenseFile=..\..\LICENSE
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
; Brand images (docs/adr/0052-app-icon-and-installer-branding.md), generated by
; assets/brand/generate.go: one file per image-area size of Inno Setup 6.6+ at
; 100/125/150/200/250 % scaling, so Setup picks a rendered one. The left panel
; shows on the finished page (the welcome page stays off, Inno's default).
WizardImageFile=..\..\assets\brand\installer\wizard-202x386.png,..\..\assets\brand\installer\wizard-269x515.png,..\..\assets\brand\installer\wizard-336x643.png,..\..\assets\brand\installer\wizard-430x824.png,..\..\assets\brand\installer\wizard-534x1022.png
WizardSmallImageFile=..\..\assets\brand\installer\wizard-small-58.png,..\..\assets\brand\installer\wizard-small-77.png,..\..\assets\brand\installer\wizard-small-97.png,..\..\assets\brand\installer\wizard-small-124.png,..\..\assets\brand\installer\wizard-small-159.png
; Language: the system one when it is Spanish or English (no question, also on
; updates); the dialog appears only for other system languages (ADR-0049).
ShowLanguageDialog=auto
; The user PATH changes: tell running programs (Explorer) to re-read it.
ChangesEnvironment=yes
; Upgrades: close a running tray through the Restart Manager.
CloseApplications=yes
RestartApplications=no

[Languages]
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "en"; MessagesFile: "compiler:Default.isl"

