{
  "name": "vpn-kongtrol-landing",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "pnpm run brand && vite",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
